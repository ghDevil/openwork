# Stage 1: Build apps/app (pnpm monorepo)
FROM node:22-bookworm-slim AS builder

ARG VITE_OPENWORK_DEPLOYMENT=web
ENV VITE_OPENWORK_DEPLOYMENT=${VITE_OPENWORK_DEPLOYMENT}

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable

WORKDIR /repo
COPY . /repo

# Install all workspace deps (needed because apps/app depends on workspace:* packages)
RUN pnpm install --frozen-lockfile=false --prefer-offline

# Build the packages/ui first (prebuild step) then the web SPA
RUN pnpm --filter @openwork/app build:web

# Stage 2: nginx serving the built SPA + proxying orchestrator paths
FROM nginx:alpine

COPY --from=builder /repo/apps/app/dist /usr/share/nginx/html
COPY packaging/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
